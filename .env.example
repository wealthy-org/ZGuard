# ==============================================================================
# ZGuard — environment reference
# Every variable below is read by the code (apps/api/src/config.ts, apps/web/next.config.mjs,
# packages/zk/src/deploy-verifier.ts, live tests). Defaults shown are the code defaults.
#
# Network policy (gap C7 / section L): run on Robinhood Chain Testnet 46630. Do not point
# production traffic or the ZK verifier at mainnet 4663 until audit + multisig owner.
# NEVER commit real private keys. Set secrets in the Vercel dashboard only.
# ==============================================================================

# ---------------------------------------------------------------- Web (apps/web)
# Base URL of the deployed API project, e.g. https://zguard-api-xxx.vercel.app
# Required on Vercel. If missing (or pointing at the web deployment itself) /v1/* and /health
# return 503 {"status":"misconfigured"} instead of looping 308 (gap C3).
ZGUARD_INTERNAL_API_URL=""

# ---------------------------------------------------------------- API server
ZGUARD_PRODUCT_NAME="ZGuard"
ZGUARD_API_PORT=8787
ZGUARD_API_HOST="0.0.0.0"
ZGUARD_PUBLIC_API_URL="http://localhost:8787"
ZGUARD_API_KEY_PREFIX="zg_"
# 46630 = RHC Testnet (default, recommended) | 4663 = RHC Mainnet
ZGUARD_ACTIVE_CHAIN_ID=46630

# ---------------------------------------------------------------- Storage (Neon Postgres)
# postgresql://<user>:<password>@<endpoint>.neon.tech/<dbname>?sslmode=require
# Required when NODE_ENV=production: without it the API answers 503 P-UNAVAIL (no JSON fallback).
DATABASE_URL=""
# "auto" (Neon if DATABASE_URL set, local JSON in dev) | "neon" (strict, fail-closed)
ZGUARD_STORAGE_MODE="auto"
# Escape hatch for demos only; keeps the ephemeral JSON store in production.
ZGUARD_ALLOW_LOCAL_STORE_IN_PRODUCTION="false"

# ---------------------------------------------------------------- Security / ops (gaps C5, C6, STORE-1)
# Admin key (>= 16 chars) for global endpoints such as GET /v1/revenue (header x-admin-key).
ZGUARD_ADMIN_API_KEY=""
# Comma-separated browser origins allowed by CORS, e.g. https://zguard-delta.vercel.app
# Empty = no cross-origin browser access (the web app uses same-origin proxying).
ZGUARD_CORS_ORIGINS=""
ZGUARD_RATE_LIMIT_PER_MINUTE=120
ZGUARD_REGISTER_LIMIT_PER_IP_PER_HOUR=5
ZGUARD_REGISTER_LIMIT_PER_PAYER_PER_HOUR=10

# ---------------------------------------------------------------- Robinhood Chain RPC
ZGUARD_RHC_TESTNET_RPC_URL="https://rpc.testnet.chain.robinhood.com"
ZGUARD_RHC_TESTNET_FALLBACK_RPC_URL="https://rpc.testnet.chain.robinhood.com"
ZGUARD_RHC_MAINNET_RPC_URL="https://rpc.mainnet.chain.robinhood.com"
ZGUARD_RHC_MAINNET_FALLBACK_RPC_URL="https://rpc.mainnet.chain.robinhood.com"
# Optional overrides for the ACTIVE chain (default: the pair above for ZGUARD_ACTIVE_CHAIN_ID)
ZGUARD_RHC_RPC_URL=""
ZGUARD_RHC_FALLBACK_RPC_URL=""
# "auto" | "eth_simulateV1" | "debug_traceCall"
ZGUARD_SIMULATION_METHOD="auto"

# Chainlink L2 sequencer uptime feed (optional)
ZGUARD_SEQUENCER_UPTIME_FEED=""
ZGUARD_SEQUENCER_GRACE_PERIOD_SECONDS=3600
ZGUARD_SEQUENCER_MAX_BLOCK_AGE_SECONDS=900

# ---------------------------------------------------------------- Registries / indexers
ZGUARD_STOCK_REGISTRY_URL="https://api.robinhood.com/rhj/assets"
ZGUARD_CHAINLINK_FEEDS_URL="https://reference-data-directory.vercel.app/feeds-robinhood-mainnet.json"
ZGUARD_REGISTRY_REFRESH_SECONDS=900
ZGUARD_HOLDER_INDEXER_URL=""
ZGUARD_ENABLE_URL_FETCH="true"
ZGUARD_URL_FETCH_TIMEOUT_MS=4000
ZGUARD_URL_FETCH_MAX_BYTES=131072

# ---------------------------------------------------------------- Billing x402 (USDG, 6 dp)
# Payee wallet that receives USDG. Set your own.
ZGUARD_X402_PAY_TO=""
# "onchain"  : relayer broadcasts transferWithAuthorization; credit after N confirmations
# "deposit"  : user sends USDG first, then X-PAYMENT {"network":"eip155:46630","payload":{"txHash","claimSignature"}}
#              claimSignature = EIP-191 over "ZGuard credit claim\ntx:<txHash lowercase>\nchain:<chainId>"
# "auto"     : onchain when a relayer key is set, otherwise deposit
# "offchain" : DEV ONLY, rejected when NODE_ENV=production (gap X402-1)
ZGUARD_X402_SETTLEMENT_MODE="auto"
ZGUARD_X402_RELAYER_PRIVATE_KEY=""
ZGUARD_X402_MIN_CONFIRMATIONS=3

ZGUARD_PRICE_VERIFY_MICRO_USDG=3000
ZGUARD_PRICE_SIMULATE_MICRO_USDG=5000
ZGUARD_PRICE_TOKEN_RISK_MICRO_USDG=10000
ZGUARD_PRICE_CHECK_MICRO_USDG=5000
ZGUARD_PRICE_GUARD_MICRO_USDG=15000
# Free credit for new keys. Code default: 0 in production, 90000 in dev. Keep 0 in production.
ZGUARD_DEV_FREE_CREDIT_MICRO_USDG=0

# Optional secondary rails
ZGUARD_ENABLE_USDC_BASE="false"
ZGUARD_BASE_RPC_URL="https://mainnet.base.org"
ZGUARD_BASE_SEPOLIA_RPC_URL="https://sepolia.base.org"
ZGUARD_ENABLE_USDC_SOLANA="false"
ZGUARD_X402_SOLANA_PAY_TO=""
ZGUARD_SOLANA_RPC_URL="https://api.mainnet-beta.solana.com"
ZGUARD_SOLANA_DEVNET_RPC_URL="https://api.devnet.solana.com"

# ---------------------------------------------------------------- Revenue (buyback/burn) · §9.9
# Addresses must be ZGuard-controlled (e.g. the "ZGuard Ops" Safe); pons/Uniswap/USDG contracts are refused
# and invalid values are hidden in /v1/config (see buyback.configErrors).
# Reconcile fee receipts and buyback/burn txs onchain: cd apps/api && tsx scripts/buyback-report.ts --chain 46630
ZGUARD_TOKEN_TICKER="$ZGUARD"
# Product token (pons launch) — empty until it exists
ZGUARD_PONS_TOKEN_ADDRESS=""
# Wallet that executes buy + burn (Safe recommended)
ZGUARD_BUYBACK_WALLET=""
ZGUARD_BURN_ADDRESS="0x000000000000000000000000000000000000dEaD"
# Integer 0..10000 (10000 = 100% of net revenue accrues to buyback)
ZGUARD_BUYBACK_REVENUE_BPS=10000

# ---------------------------------------------------------------- Decision policy
ZGUARD_REQUIRED_CHECKS="quote,simulation,token_risk"
ZGUARD_ALLOW_TTL_SECONDS=120
ZGUARD_ALLOW_ABSTAIN_OVERRIDE="false"
ZGUARD_MAX_TAX_BPS=""
ZGUARD_MAX_TOP10_HOLDER_BPS=""
ZGUARD_MAX_SNIPE_TAX_BPS=""

# ---------------------------------------------------------------- ZK attestation (scope = quote)
# Without an SP1 prover + deployed verifier every attestation stays "pending" (honest semantics).
ZGUARD_ZK_ENABLED="true"
ZGUARD_ZK_SYSTEM="groth16-sp1"
# Halo2 is a skeleton (no prover/verifier). Opt-in only; still returns "pending".
ZGUARD_ZK_HALO2_ENABLED="false"
ZGUARD_ZK_SP1_PROVER_URL=""
# vkey printed by `cargo prove vkey` for packages/zk/sp1-quote-guest
ZGUARD_ZK_SP1_PROGRAM_VKEY=""
# Succinct SP1 verifier gateway on RHC 46630 (needed by `pnpm deploy:verifier`)
ZGUARD_ZK_SP1_GATEWAY=""
# Deployed ZGuardQuoteVerifier (testnet 46630)
ZGUARD_ZK_VERIFIER_ADDRESS=""
# Key that sends verifySp1QuoteProof txs (optional; without it status stops at "proven")
ZGUARD_ZK_VERIFIER_PRIVATE_KEY=""
# Deployer key for `pnpm deploy:verifier` (testnet only). Transfer ownership to a multisig afterwards.
ZGUARD_DEPLOYER_PRIVATE_KEY=""
ZGUARD_ZK_BATCH_SIZE=10

# ---------------------------------------------------------------- Live tests (optional)
# Graduated pons token on the chain under test, for acceptance.test.ts (skipped when empty).
ZGUARD_TEST_PONS_GRADUATED_TOKEN=""
