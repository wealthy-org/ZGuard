# ==============================================================================
# ZGuard — Open Config (§10 Dev Brief)
# Do NOT hardcode unverified addresses or thresholds in code.
# ==============================================================================

# --- Product & Server ---
ZGUARD_PRODUCT_NAME="ZGuard"
ZGUARD_API_PORT=8787
ZGUARD_API_HOST="0.0.0.0"
# Public base URL of Hosted API [PERLU CEK sebelum produksi]
ZGUARD_PUBLIC_API_URL="http://localhost:8787"
# API Key prefix [ASUMSI: zg_, sengaja bukan awk_]
ZGUARD_API_KEY_PREFIX="zg_"

# --- Storage: Neon Serverless Postgres ---
# Isi connection string dari dashboard Neon:
# postgresql://<user>:<password>@<endpoint>.neon.tech/<dbname>?sslmode=require
DATABASE_URL=""
# Mode storage: "auto" (Neon jika DATABASE_URL diisi, fallback file lokal saat dev) | "neon" (wajib Neon, fail-closed P-UNAVAIL jika gagal)
ZGUARD_STORAGE_MODE="auto"

# --- Robinhood Chain (RHC 4663) RPC ---
# Produksi disarankan Alchemy: https://robinhood-mainnet.g.alchemy.com/v2/<API_KEY>
ZGUARD_RHC_RPC_URL="https://rpc.mainnet.chain.robinhood.com"
ZGUARD_RHC_FALLBACK_RPC_URL="https://rpc.mainnet.chain.robinhood.com"
ZGUARD_RHC_TESTNET_RPC_URL="https://rpc.testnet.chain.robinhood.com"
# Metode simulasi: "auto" (eth_simulateV1 -> debug_traceCall -> eth_call) | "eth_simulateV1" | "debug_traceCall"
ZGUARD_SIMULATION_METHOD="auto"

# --- Official Directories (di-refresh berkala, bukan daftar statis) ---
ZGUARD_STOCK_REGISTRY_URL="https://api.robinhood.com/rhj/assets"
ZGUARD_CHAINLINK_FEEDS_URL="https://reference-data-directory.vercel.app/feeds-robinhood-mainnet.json"
ZGUARD_REGISTRY_REFRESH_SECONDS=900

# --- Billing x402 (USDG 6 desimal di RHC 4663) [ASUMSI tarif] ---
ZGUARD_X402_PAY_TO=""
ZGUARD_PRICE_VERIFY_MICRO_USDG=3000
ZGUARD_PRICE_SIMULATE_MICRO_USDG=5000
ZGUARD_PRICE_TOKEN_RISK_MICRO_USDG=10000
ZGUARD_PRICE_CHECK_MICRO_USDG=5000
ZGUARD_PRICE_GUARD_MICRO_USDG=15000
# Kredit percobaan saat dev lokal (0 di produksi — wajib bayar x402)
ZGUARD_DEV_FREE_CREDIT_MICRO_USDG=60000
ZGUARD_ENABLE_USDC_BASE="false"
ZGUARD_ENABLE_USDC_SOLANA="false"

# --- Revenue & Buyback/Burn (§2.3 & §10) [ASUMSI, jangan pakai alamat $WORM] ---
ZGUARD_TOKEN_TICKER="$ZGUARD"
ZGUARD_PONS_TOKEN_ADDRESS=""
ZGUARD_BUYBACK_WALLET=""
ZGUARD_BURN_ADDRESS="0x000000000000000000000000000000000000dEaD"
ZGUARD_BUYBACK_REVENUE_BPS=10000

# --- Decision Engine & Policy (§4.5 & §10) ---
ZGUARD_REQUIRED_CHECKS="quote,simulation,token_risk"
ZGUARD_ALLOW_TTL_SECONDS=120
ZGUARD_ALLOW_ABSTAIN_OVERRIDE="false"
# Ambang T-TAX / T-HOLDER (kosong = laporkan angka mentah + flag tanpa auto-deny, kecuali T-MINT pada kind=other)
ZGUARD_MAX_TAX_BPS=""
ZGUARD_MAX_TOP10_HOLDER_BPS=""
ZGUARD_MAX_SNIPE_TAX_BPS=""
ZGUARD_HOLDER_INDEXER_URL=""

# --- ZK Attestation Layer (§8.3) ---
ZGUARD_ZK_ENABLED="true"
# Sistem default: "groth16-sp1" | "groth16-risc0" | "halo2-kzg"
ZGUARD_ZK_SYSTEM="groth16-sp1"
ZGUARD_ZK_HALO2_ENABLED="true"
ZGUARD_ZK_PROVER_MODE="local-bn254"
ZGUARD_ZK_SP1_PROVER_URL=""
ZGUARD_ZK_VERIFIER_ADDRESS=""
ZGUARD_ZK_BATCH_SIZE=10
