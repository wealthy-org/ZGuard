# ==============================================================================
# ZGuard — Open Config (§10 Dev Brief)
# Default Target: Robinhood Chain Testnet (`46630`) for zero-fee web testing & review.
# Switch to Production Mainnet (`4663`) anytime by setting ZGUARD_ACTIVE_CHAIN_ID=4663!
# ==============================================================================

# --- Product & Server ---
ZGUARD_PRODUCT_NAME="ZGuard"
ZGUARD_API_PORT=8787
ZGUARD_API_HOST="0.0.0.0"
ZGUARD_PUBLIC_API_URL="http://localhost:8787"
ZGUARD_API_KEY_PREFIX="zg_"

# --- Active Network Target (46630 = Robinhood Chain Testnet | 4663 = Mainnet) ---
ZGUARD_ACTIVE_CHAIN_ID=46630

# --- Storage: Neon Serverless Postgres ---
# postgresql://<user>:<password>@<endpoint>.neon.tech/<dbname>?sslmode=require
DATABASE_URL=""
# "auto" (Neon if DATABASE_URL set, local JSON fallback in dev) | "neon" (strict Neon, fail-closed P-UNAVAIL)
ZGUARD_STORAGE_MODE="auto"

# --- Robinhood Chain RPC & Blockscout Indexer ---
ZGUARD_RHC_TESTNET_RPC_URL="https://rpc.testnet.chain.robinhood.com"
ZGUARD_RHC_TESTNET_FALLBACK_RPC_URL="https://rpc.testnet.chain.robinhood.com"
ZGUARD_RHC_RPC_URL="https://rpc.mainnet.chain.robinhood.com"
ZGUARD_RHC_FALLBACK_RPC_URL="https://rpc.mainnet.chain.robinhood.com"
ZGUARD_SIMULATION_METHOD="auto"

# Optional Chainlink L2 Sequencer Uptime Feed & staleness window (§6.2 & §7.3)
ZGUARD_L2_SEQUENCER_FEED_ADDRESS=""
ZGUARD_SEQUENCER_GRACE_SECONDS=3600
ZGUARD_MAX_BLOCK_STALE_SECONDS=300

# --- Official Directories & Live Pricing ---
ZGUARD_STOCK_REGISTRY_URL="https://api.robinhood.com/rhj/assets"
ZGUARD_ROBINHOOD_PRICES_BASE_URL="https://api.robinhood.com/rhj/prices"
ZGUARD_CHAINLINK_FEEDS_URL="https://reference-data-directory.vercel.app/feeds-robinhood-mainnet.json"
ZGUARD_REGISTRY_REFRESH_SECONDS=900

# --- Holder Concentration Indexer (§6.3 T-HOLDER) ---
ZGUARD_TESTNET_BLOCKSCOUT_API_URL="https://explorer.testnet.chain.robinhood.com/api/v2"
ZGUARD_MAINNET_BLOCKSCOUT_API_URL="https://robinhoodchain.blockscout.com/api/v2"
ZGUARD_HOLDER_INDEXER_URL=""

# --- Remote URL / Metadata SSRF Scanner (§2.2 & §6.4) ---
ZGUARD_URL_FETCH_TIMEOUT_MS=4500
ZGUARD_URL_FETCH_MAX_BYTES=65536

# --- Billing x402 (USDG 6dp on RHC 46630/4663 + Optional Base & Solana USDC) ---
ZGUARD_X402_PAY_TO=""
# "simulate" | "onchain" | "auto" (broadcasts transferWithAuthorization onchain if ZGUARD_X402_RELAYER_PRIVATE_KEY is set)
ZGUARD_X402_SETTLEMENT_MODE="auto"
ZGUARD_X402_RELAYER_PRIVATE_KEY=""

ZGUARD_PRICE_VERIFY_MICRO_USDG=3000
ZGUARD_PRICE_SIMULATE_MICRO_USDG=5000
ZGUARD_PRICE_TOKEN_RISK_MICRO_USDG=10000
ZGUARD_PRICE_CHECK_MICRO_USDG=5000
ZGUARD_PRICE_GUARD_MICRO_USDG=15000
ZGUARD_DEV_FREE_CREDIT_MICRO_USDG=60000

# Optional Secondary Payment Rails (§2.1)
ZGUARD_ENABLE_USDC_BASE="false"
ZGUARD_BASE_CHAIN_ID=84532
ZGUARD_BASE_RPC_URL="https://sepolia.base.org"
ZGUARD_ENABLE_USDC_SOLANA="false"
ZGUARD_SOLANA_NETWORK="solana:devnet"
ZGUARD_SOLANA_PAY_TO=""
ZGUARD_SOLANA_RPC_URL="https://api.devnet.solana.com"

# --- Revenue & Buyback/Burn (§2.3 & §10) ---
ZGUARD_TOKEN_TICKER="$ZGUARD"
ZGUARD_PONS_TOKEN_ADDRESS=""
ZGUARD_BUYBACK_WALLET=""
ZGUARD_BURN_ADDRESS="0x000000000000000000000000000000000000dEaD"
ZGUARD_BUYBACK_REVENUE_BPS=10000

# --- Decision Engine & Policy (§4.5 & §10) ---
ZGUARD_REQUIRED_CHECKS="quote,simulation,token_risk"
ZGUARD_ALLOW_TTL_SECONDS=120
ZGUARD_ALLOW_ABSTAIN_OVERRIDE="false"
ZGUARD_MAX_TAX_BPS=""
ZGUARD_MAX_TOP10_HOLDER_BPS=""
ZGUARD_MAX_SNIPE_TAX_BPS=""

# --- ZK Attestation Layer (§8.3) ---
ZGUARD_ZK_ENABLED="true"
ZGUARD_ZK_SYSTEM="groth16-sp1"
ZGUARD_ZK_HALO2_ENABLED="true"
ZGUARD_ZK_PROVER_MODE="local-bn254"
ZGUARD_ZK_SP1_PROVER_URL=""
# Deploy via `pnpm deploy:verifier` on RHC Testnet (46630) and paste address here:
ZGUARD_ZK_VERIFIER_ADDRESS=""
ZGUARD_ZK_VERIFIER_PRIVATE_KEY=""
ZGUARD_ZK_BATCH_SIZE=10
