{
  "name": "@zguard/zk",
  "version": "0.1.0",
  "description": "ZGuard quote attestation layer: SP1 Groth16 verifier contract + async prover client (SP1 guest is a scaffold; Halo2 is a skeleton)",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "compile:sol": "node scripts/compile-solidity.mjs",
    "build": "node scripts/compile-solidity.mjs && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "deploy": "tsx src/deploy-verifier.ts",
    "fixtures:sp1": "node scripts/gen-sp1-fixtures.mjs"
  },
  "dependencies": {
    "@zguard/sdk": "workspace:*",
    "viem": "^2.30.0"
  },
  "devDependencies": {
    "solc": "0.8.28"
  }
}
