{
  "name": "@zguard/zk",
  "version": "0.1.0",
  "description": "ZGuard ZK attestation layer (Groth16 BN254 + Halo2-KZG commitments, async prover, and RHC 4663 ecPairing verifier)",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "compile:sol": "node scripts/compile-solidity.mjs",
    "build": "node scripts/compile-solidity.mjs && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "deploy": "tsx src/deploy-verifier.ts"
  },
  "dependencies": {
    "@zguard/sdk": "workspace:*",
    "viem": "^2.30.0"
  },
  "devDependencies": {
    "solc": "0.8.28"
  }
}
